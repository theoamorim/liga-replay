rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isImage() {
      return request.resource.size <= 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    function ownsPlayer(playerId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('playerId', null) == playerId;
    }

    match /teams/{file} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    match /players/{playerId}/{file} {
      allow read: if true;
      allow write: if (isAdmin() || ownsPlayer(playerId)) && isImage();
    }
  }
}
